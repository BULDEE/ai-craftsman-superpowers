#!/usr/bin/env bash
# Install through Grok's native plugin manager. Compatibility wiring is opt-in.
set -euo pipefail
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
    _target=$(readlink "$_self")
    [[ "$_target" == /* ]] && _self="$_target" || _self="$(dirname "$_self")/$_target"
done
ROOT="$(cd "$(dirname "$_self")/.." && pwd)"
MODE="${1:---native}"
case "$MODE" in
    --native|--compat-hooks) ;;
    *) echo "Usage: craftsman-grok-install [--native|--compat-hooks]" >&2; exit 2 ;;
esac
# `grok plugin install` exits when the repo is already installed, and with
# set -e that exit used to skip the export. The gate is the part that runs.
install_log=$(grok plugin install "$ROOT" --trust 2>&1) || install_rc=$?
if [[ "${install_rc:-0}" -eq 0 ]]; then
    printf '%s\n' "$install_log"
elif [[ "$install_log" != *"already installed"* ]]; then
    printf '%s\n' "$install_log" >&2
    exit "$install_rc"
fi
# Grok 1.0.40 does not execute plugin-bundled hooks, whether hooks.json is a
# path or the handlers are inlined in the manifest (a fresh grok -p wrote the
# file and an inline PreToolUse marker never ran). The gate that runs is this
# global file. --native and --compat-hooks both write it; the flag remains so
# older instructions still work. Global hooks need no extra trust.
bash "$ROOT/ci/craftsman-ci.sh" export --target grok-hooks --into "${HOME}/.grok/hooks"
echo "Write gate: ${HOME}/.grok/hooks/craftsman.json"
echo "Grok 1.0.40 does not run plugin-bundled hooks. This file is the gate."
