#!/usr/bin/env bash
# =============================================================================
# craftsman-healthcheck - the plugin's own diagnostic, as one command
#
# Usage: craftsman-healthcheck            the report, rendered, one line per check
#        craftsman-healthcheck --json     the same checks as a JSON array
#
# A skill body is text handed to a model, and a multi-line `source ... && ...`
# chain is something a model edits, shortens or replaces with a diagnosis of
# its own: measured on 2026-09-20, /craftsman:healthcheck answered
# "Installation incomplete" with invented check names while the documented
# command, run verbatim in the same directory with the same PATH, printed a
# healthy report. One command with no substitutions removes that freedom.
#
# Everything is resolved from this file's own installation, so the working
# directory is the user's project, as it always is in a Bash tool.
# =============================================================================
set -uo pipefail
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
    _target=$(readlink "$_self")
    [[ "$_target" == /* ]] && _self="$_target" || _self="$(dirname "$_self")/$_target"
done
ROOT="$(cd "$(dirname "$_self")/.." && pwd)"
source "$ROOT/hooks/lib/config.sh" || exit 1
source "$ROOT/hooks/lib/pack-loader.sh" || exit 1
pack_loader_init 2>/dev/null
source "$ROOT/hooks/lib/healthcheck.sh" || exit 1
# The rendered form is the default because a model asked to "present the
# checks" rewrites them: one session displayed `lsp: warn, none installed` as
# "LSP ok, 4 servers active" and headed the report ALL GREEN (2026-09-20).
# What cannot be improved is a table the command already drew.
_report() {
    hc_run_all
    local i status icon ok=0 warn=0 err=0
    printf '%s\n' "Craftsman healthcheck"
    for i in "${!_HC_NAMES[@]}"; do
        status="${_HC_STATUSES[$i]}"
        case "$status" in
            ok)   icon="[ok]  "; ok=$((ok + 1)) ;;
            warn) icon="[warn]"; warn=$((warn + 1)) ;;
            *)    icon="[err] "; err=$((err + 1)) ;;
        esac
        printf '  %s %-16s %s\n' "$icon" "${_HC_NAMES[$i]}" "${_HC_MESSAGES[$i]}"
    done
    printf '  %d ok, %d warning(s), %d error(s)\n' "$ok" "$warn" "$err"
}

case "${1:---report}" in
    --report) _report ;;
    --json) hc_json ;;
    --summary) hc_summary ;;
    *) echo "Usage: craftsman-healthcheck [--report|--json|--summary]" >&2; exit 1 ;;
esac
