// =============================================================================
// Craftsman Quality Gate - Jenkins Pipeline template
//
// Usage:
//   1. Copy this file as 'Jenkinsfile' or load it via shared library
//   2. Adjust agent/docker image as needed
//
// The generic adapter writes annotations to stdout and a markdown comment
// to craftsman-comment.md for downstream consumption.
// =============================================================================

pipeline {
    agent {
        docker {
            image 'python:3.12-slim'
        }
    }

    stages {
        stage('Setup') {
            steps {
                script {
                    if (fileExists('composer.json')) {
                        sh 'composer install --no-interaction --prefer-dist'
                    }
                    if (fileExists('package.json')) {
                        sh 'npm ci'
                    }
                }
            }
        }

        stage('Craftsman Quality Gate') {
            steps {
                sh 'chmod +x ci/craftsman-ci.sh'
                // Runs through the generic adapter, so this stage gets the same
                // verdict as every other provider: annotations on stdout,
                // craftsman-comment.md written, and the fail-closed exit code
                // (2 = violations, 1 = warnings only, and an unreadable or
                // empty scan is a failure, not a pass). Parsing the JSON here
                // instead, as this template used to, bypassed all of that and
                // never produced the comment file it archives below.
                script {
                    int status = sh(
                        script: 'bash ci/craftsman-ci.sh ci --provider generic',
                        returnStatus: true
                    )
                    if (status == 2) {
                        error 'Craftsman quality gate failed. See the annotations above.'
                    }
                    if (status == 1) {
                        unstable 'Craftsman reported warnings.'
                    }
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'craftsman-report.json,craftsman-comment.md', allowEmptyArchive: true
        }
        failure {
            echo 'Craftsman Quality Gate failed - check violations in the console output or craftsman-comment.md'
        }
    }
}
