# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Local config (users generate their own)
.craft-config.yml
.claude/
# Host-generated Grok wiring (`craftsman-ci export --target grok-hooks`)
.grok/
# A contributor's own Codex project layer (hooks, shell policy). The plugin
# ships to Codex through .codex-plugin/ and .agents/plugins/, never through here.
.codex/

# Superpowers local data (specs, plans generated by superpowers plugin)
docs/superpowers/

# Logs
*.log

# Test artifacts
coverage/
.nyc_output/

# Python bytecode
__pycache__/
*.pyc

# External tool junk (graphify skill, Playwright MCP)
graphify-out/
.playwright-mcp/

# Node dependencies (installed on demand, e.g. packs/ai-ml/mcp/knowledge-rag)
node_modules/

# Generated by `claude plugin eval`: reports and per-run results.
evals/results/
