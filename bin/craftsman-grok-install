#!/usr/bin/env bash
# Install through Grok's native plugin manager. Compatibility wiring is opt-in.
set -euo pipefail
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
    _target=$(readlink "$_self")
    [[ "$_target" == /* ]] && _self="$_target" || _self="$(dirname "$_self")/$_target"
done
ROOT="$(cd "$(dirname "$_self")/.." && pwd)"
MODE="${1:---native}"
case "$MODE" in
    --native|--compat-hooks) ;;
    *) echo "Usage: craftsman-grok-install [--native|--compat-hooks]" >&2; exit 2 ;;
esac
grok plugin install "$ROOT" --trust
if [[ "$MODE" == "--compat-hooks" ]]; then
    bash "$ROOT/ci/craftsman-ci.sh" export --target grok-hooks --into "${HOME}/.grok/hooks"
    echo "Compatibility hooks written to ${HOME}/.grok/hooks/craftsman.json"
    exit 0
fi
echo "Native plugin installed; no global or project hooks exported."
echo "Grok 1.0.34 misses plugin hooks at startup: reload in /hooks or /plugins."
echo "Check plugin/craftsman handlers and a refused write. Initial SessionStart is not replayed."
